#!/bin/bash
# Boots a UI instance: installs Docker, reads configuration and secrets from SSM Parameter Store
# with the instance role, and runs the UI image. No secret is part of this script.
set -euo pipefail
umask 077

REGION="${region}"
dnf install -y docker
systemctl enable --now docker

param() {
  aws ssm get-parameter --region "$REGION" --with-decryption --name "$1" \
    --query Parameter.Value --output text
}

install -d -m 0700 /etc/taskboard
{
  echo "HOST=0.0.0.0"
  echo "PORT=${port}"
  echo "API_BASE_URL=${api_base_url}"
  echo "PUBLIC_URL=${public_url}"
  echo "COOKIE_SECURE=true"
  echo "TRUST_PROXY=1"
  echo "LOG_LEVEL=info"
  echo "SERVICE_TOKEN=$(param "${service_token_parameter}")"
  echo "UI_SECRET=$(param "${ui_secret_parameter}")"
} >/etc/taskboard/ui.env
chmod 0600 /etc/taskboard/ui.env

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${registry}"
docker pull "${image}"

docker run -d --name taskboard-ui --restart unless-stopped \
  --env-file /etc/taskboard/ui.env \
  -p ${port}:${port} \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m \
  --cap-drop ALL --security-opt no-new-privileges:true \
  --pids-limit 256 --memory 512m \
  --log-driver awslogs --log-opt awslogs-region="$REGION" --log-opt awslogs-group="${log_group}" \
  "${image}"
