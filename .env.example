# Copy to .env (git-ignored) and replace every "change-me" value.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Shared secrets ------------------------------------------------------------------------------
# PostgreSQL password of the "taskboard" user (Compose creates the database).
POSTGRES_PASSWORD=change-me-postgres-password
# Redis AUTH password.
REDIS_PASSWORD=change-me-redis-password
# Shared secret the UI sends to the API in X-Service-Token (at least 32 characters).
SERVICE_TOKEN=change-me-service-token-at-least-32-characters
# UI secret for CSRF tokens and signed cookies (at least 32 characters).
UI_SECRET=change-me-ui-secret-at-least-32-characters-long

# --- UI server -----------------------------------------------------------------------------------
# Host port the UI is published on (127.0.0.1 only).
UI_PORT=3000
# URL users open; must match the browser's origin for the CSRF origin check.
PUBLIC_URL=http://localhost:3000
# Set to true when the UI is served over HTTPS (always true in AWS).
COOKIE_SECURE=false
# debug | info | warn | error
UI_LOG_LEVEL=info

# --- API -----------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR (DEBUG shows cache hit/miss lines)
API_LOG_LEVEL=INFO
# Write full email bodies, including password reset links, to the API log (dev only).
MAILER_LOG_BODY=true
# Allow http:// webhook URLs and private/loopback webhook targets (local testing only).
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# --- First admin (make admin) --------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Administrator

# --- Further API settings (defaults shown; set them in docker-compose.yml if needed) -------------
# DATABASE_URL                  built by Compose from POSTGRES_PASSWORD
# REDIS_URL                     built by Compose from REDIS_PASSWORD
# CACHE_ENABLED=true            set false to run without Redis caching
# CACHE_TTL_SECONDS=300         backstop TTL; writes invalidate keys explicitly
# SESSION_TTL_HOURS=12
# PASSWORD_RESET_TTL_MINUTES=30
# STORAGE_BACKEND=local         s3 in AWS (with S3_BUCKET, S3_PREFIX, S3_KMS_KEY_ID, AWS_REGION)
# MAX_UPLOAD_BYTES=10485760
# LOGIN_RATE_LIMIT_PER_EMAIL=10 LOGIN_RATE_LIMIT_PER_IP=50 LOGIN_RATE_WINDOW_SECONDS=900
# WEBHOOK_TIMEOUT_SECONDS=5     WEBHOOK_MAX_ATTEMPTS=3 WEBHOOK_BACKOFF_SECONDS=0.5
# API_HOST=0.0.0.0 API_PORT=8000 (container defaults)

# --- Further UI settings (defaults shown) ---------------------------------------------------------
# API_BASE_URL=http://api:8000  set by Compose
# API_REQUEST_TIMEOUT_MS=10000
# TRUST_PROXY=0                 1 behind the AWS load balancer
# MAX_UPLOAD_BYTES=10485760
