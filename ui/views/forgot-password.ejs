<%- include("partials/head", { title: "Forgot password" }) %>
<h1>Forgot your password?</h1>
<form method="post" action="/forgot-password" class="card narrow" novalidate>
  <%- include("partials/csrf") %>
  <%- include("partials/form-error") %>
  <p>Enter your email address and we will send you a link to choose a new password.</p>
  <%- include("partials/field", { name: "email", label: "Email", type: "email", value: values.email, required: true, autocomplete: "email", maxlength: 254 }) %>
  <button type="submit">Send reset link</button>
</form>
<p><a href="/login">Back to log in</a></p>
<%- include("partials/foot") %>
