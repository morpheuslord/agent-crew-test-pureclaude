<%- include("partials/head", { title: "Choose a new password" }) %>
<h1>Choose a new password</h1>
<form method="post" action="/reset-password" class="card narrow" novalidate>
  <%- include("partials/csrf") %>
  <%- include("partials/form-error") %>
  <input type="hidden" name="token" value="<%= token %>">
  <% if (errors.token) { %><p class="field-error"><%= errors.token %></p><% } %>
  <%- include("partials/field", { name: "password", label: "New password (at least 10 characters)", type: "password", value: "", required: true, autocomplete: "new-password", maxlength: 128 }) %>
  <%- include("partials/field", { name: "password_confirm", label: "Repeat new password", type: "password", value: "", required: true, autocomplete: "new-password", maxlength: 128 }) %>
  <button type="submit">Set password</button>
</form>
<%- include("partials/foot") %>
